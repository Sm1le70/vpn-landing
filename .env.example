# ---------- Сайт ----------
PORT=3000
# Публичный адрес сайта (без слэша в конце). Нужен для return-URL Platega и ссылок в письмах.
SITE_URL=https://example.com
BRAND_NAME=MyVPN
SUPPORT_EMAIL=support@example.com
# Юзернейм без @ (можно оставить пустым)
SUPPORT_TELEGRAM=example_support
# Дата редакции документов (политика, соглашение)
DOCS_DATE=22.09.2026
# Кодовое слово для проверки Platega. После регистрации кассы — очистить.
VERIFICATION_PHRASE=платега верификация
# Секрет для хэширования кодов входа и сессий (любая длинная случайная строка)
APP_SECRET=change-me-to-a-long-random-string
# Путь к файлу SQLite
DATABASE_PATH=./data/app.db

# ---------- Подписка ----------
# Лимит устройств для платной подписки (0 = без лимита)
PAID_DEVICE_LIMIT=3
TRIAL_ENABLED=true
TRIAL_DAYS=3
TRIAL_DEVICE_LIMIT=1

# ---------- Remnawave ----------
# Адрес панели. Если бэкенд ходит в панель по внутренней сети Docker — http://remnawave:3000
REMNAWAVE_URL=https://panel.example.com
# API-токен: Панель → Remnawave Settings → API Tokens
REMNAWAVE_TOKEN=
# UUID внутренних сквадов через запятую (Internal Squads), которые получает пользователь
REMNAWAVE_SQUADS=
# Необязательно: тег пользователя в панели (A-Z, 0-9, _; до 16 символов)
REMNAWAVE_USER_TAG=WEB
# Необязательно: cookie, если панель закрыта reverse-proxy с доступом по cookie (формат name=value)
REMNAWAVE_COOKIE=
# Секрет вебхуков Remnawave (WEBHOOK_SECRET_HEADER в .env панели). Нужен для проверки HWID на пробном периоде.
REMNAWAVE_WEBHOOK_SECRET=

# ---------- Platega ----------
PLATEGA_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# ---------- Resend ----------
# Для обращений нужен ключ с правами Full access (чтение входящих писем), а не только Sending access
RESEND_API_KEY=
# Отправитель: домен должен быть подтверждён в Resend
MAIL_FROM=MyVPN <no-reply@example.com>

# ---------- Обращения в поддержку (Resend Inbound) ----------
# Signing Secret вебхука email.received (whsec_...). Пусто — приём писем выключен (вебхук отвечает 503).
RESEND_INBOUND_WEBHOOK_SECRET=
# Отправитель ответов из админки. Пусто — "<BRAND_NAME> <email поддержки из настроек>"
SUPPORT_FROM=Поддержка <support@example.com>
# Необязательно: куда слать короткое уведомление о новом обращении (без текста письма). Пусто — не слать.
SUPPORT_NOTIFY_EMAIL=

# ---------- Поддержка в Telegram (бот + группа с темами) ----------
# Токен бота от @BotFather. Пусто — бот выключен.
TELEGRAM_BOT_TOKEN=
# ID закрытой группы с темами (-100...). Узнать: добавьте бота в группу и напишите там /chat_id
TELEGRAM_SUPPORT_CHAT_ID=
# Необязательно: ответ на первое сообщение обращения. Пустое значение — не отвечать.
# TELEGRAM_AUTOREPLY=Сообщение получено, ответим здесь же в ближайшее время.

# ---------- Админка ----------
# Секретный путь к админке (латиница/цифры, от 6 символов), например /panel-x7k2.
# Пусто — админка выключена. При первом запуске ссылка для создания администратора появится в логах.
ADMIN_PATH=

# ---------- Резервные копии ----------
# Публичный ключ age (age1...): копии базы и .env шифруются (scripts/backup.sh, раздел «Резервная копия» в README).
# Пусто — копии не шифруются. Приватный ключ на сервере не храните.
BACKUP_AGE_RECIPIENT=
